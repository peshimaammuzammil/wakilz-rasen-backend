# ── Rasen.ai ──────────────────────────────────────────────────────────────────
# Workspace API base URL (confirmed from Rasen docs)
RASEN_API_BASE=https://kalpa-api-454269687527.asia-south1.run.app/api/rasen/workspace

# Your workspace API key (from Rasen dashboard → Developers → Workspace keys)
RASEN_API_KEY=rkw_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your published agent ID
RASEN_AGENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Webhook signing secret — get from Rasen dashboard → Developers → Webhooks
# Leave empty during dev (verification is skipped with a warning)
RASEN_WEBHOOK_SECRET=

# ── Auth ──────────────────────────────────────────────────────────────────────
# Random 32-char hex — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-32-char-hex-string

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGIN=https://peshimaammuzammil.github.io

# ── HubSpot ───────────────────────────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=pat-na2-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Firebase / Firestore ──────────────────────────────────────────────────────
# Your Firebase project ID (from firebase.ts)
FIREBASE_PROJECT_ID=wakilz-dasboard

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
MAX_CONCURRENT_SESSIONS=10

# ── Optional: simple admin API key (for AdminDashboard backend calls) ─────────
# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
ADMIN_API_KEY=
